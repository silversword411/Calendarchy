{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--workspace"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo run",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "-p", "calendarchy"],
            "group": "none",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "Calendarchy: Watch and run",
            "type": "process",
            "command": "${env:HOME}/.cargo/bin/watchexec",
            "args": [
                "--restart",
                "-w", "crates",
                "-w", "Cargo.toml",
                "-w", "Cargo.lock",
                "--", "cargo", "run", "-p", "calendarchy"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$rustc"],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "runOptions": { "instanceLimit": 1 }
        },
        {
            "label": "cargo test",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "--workspace"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        }
    ]
}
