{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cargo build",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--workspace"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo run",
            "type": "shell",
            "command": "cargo",
            "args": ["run", "-p", "calendarchy"],
            "group": "none",
            "problemMatcher": ["$rustc"]
        },
        {
            "label": "cargo test",
            "type": "shell",
            "command": "cargo",
            "args": ["test", "--workspace"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$rustc"]
        }
    ]
}
